                "type": "text/javascript",
                "exec": [
                  "pm.test(\"respuesta JSON\", function () {",
                  "    pm.response.to.be.success;",
                  "    pm.response.to.have.jsonBody();",
                  "});"
                ]
              }
            }
          ]
        }
      ]
