    {
      "name": "00. Health Check",
      "item": [
        {
          "name": "Salud clase 04",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v4/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Salud clase 03 sigue viva",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"clase 03\", () => pm.expect(pm.response.json().servicio).to.eql(\"estudia-clase03\"));"
                ]
              }
            }
          ]
        }
      ]
