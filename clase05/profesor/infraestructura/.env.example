# Copia este archivo a .env con el script preparar. No subas .env al repositorio.
# La contraseña de abajo solo abre Airflow en este portatil. No es la de PostgreSQL.

FERNET_KEY=cambia-esta-clave-fernet
JWT_SECRET=cambia-esta-clave-jwt
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=estudia-local
AIRFLOW_WEB_PORT=8080
